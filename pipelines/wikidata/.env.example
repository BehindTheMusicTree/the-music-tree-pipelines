# Copy to .env (git-ignored). Auto-loaded by wikidata.bronze_wikidata and wikidata.silver_wikidata
# via common.env.load_pipeline_env() — no manual export needed.
#
# No connection credentials required: wikidata.wikidata_client queries the public
# https://query.wikidata.org/sparql endpoint directly, no API key or auth.

# Output directories for bronze/silver-layer Parquet files (git-ignored). Relative here as
# portable placeholders — in your own .env, prefer absolute paths so the location stays
# deterministic regardless of the working directory a command is run from.
BRONZE_OUTPUT_DIR=bronze
SILVER_OUTPUT_DIR=silver

# Bronze curation CSVs (<list>.csv) written by `uv run --package curation python -m curation.ingest`
# from grow-the-music-tree-api's curation export. Same portability note as above.
CURATION_BRONZE_DIR=../curation/bronze

# geohistory Bronze output, whose natural_earth_admin.parquet seeds wikidata_admin_hierarchy.parquet: run
# `uv run --package geohistory python -m geohistory.ingest` first. Same portability note as above.
GEOHISTORY_BRONZE_DIR=../geohistory/bronze

# Independent image worker only; all paths absolute and separate from catalogue outputs.
# Bootstrap before the first refresh; see DESIGN.md.
# ARTIST_IMAGES_STATE_DIR=/absolute/environment-data/artist-images/state
# ARTIST_IMAGES_PUBLISHED_DIR=/absolute/environment-data/artist-images/published
# ARTIST_IMAGES_WRITER_LOCK_FILE=/absolute/locks/artist-images-environment.lock
# ARTIST_IMAGES_BACKGROUND_LOCK_FILE=/absolute/locks/artist-images-background.lock
# MUSIC_TREE_PIPELINES_LOCK_FILE=/absolute/locks/music-tree-pipelines.lock
# ARTIST_IMAGES_PRODUCER_COMMIT=full-git-commit
# ARTIST_IMAGES_MAX_WDQS_ATTEMPTS=64
# ARTIST_IMAGES_MAX_ENTITY_API_ATTEMPTS=64
# ARTIST_IMAGES_MAX_COMMONS_HTTP_ATTEMPTS=400
# ARTIST_IMAGES_RUN_BUDGET_SECONDS=2700
# ARTIST_IMAGES_DISCOVERY_INTERVAL_DAYS=7
# ARTIST_IMAGES_CLAIMS_TTL_DAYS=7
# ARTIST_IMAGES_NEGATIVE_TTL_DAYS=30
# ARTIST_IMAGES_METADATA_TTL_DAYS=30
# ARTIST_IMAGES_MISSING_METADATA_TTL_DAYS=7
