# Copy to .env (git-ignored). Auto-loaded by wikidata.bronze_wikidata via
# common.env.load_pipeline_env() — no manual export needed.
#
# No connection credentials required: wikidata.wikidata_client queries the public
# https://query.wikidata.org/sparql endpoint directly, no API key or auth.

# Output directory for bronze-layer Parquet files (git-ignored). Relative here as a portable
# placeholder — in your own .env, prefer an absolute path so the location stays deterministic
# regardless of the working directory a command is run from.
BRONZE_OUTPUT_DIR=bronze
