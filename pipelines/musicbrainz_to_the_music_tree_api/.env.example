# Copy to .env (git-ignored) and load manually (export, direnv, etc.) — not auto-loaded by the code.
# Required by musicbrainz_to_the_music_tree_api.db.connect(); values below match the local
# sample DB started by scripts/setup-sample-db.sh.
MB_HOST=127.0.0.1
MB_PORT=5432
MB_DB=musicbrainz_db
MB_USER=musicbrainz
PGPASSWORD=musicbrainz

# Output directory for bronze-layer Parquet files (git-ignored).
MB_BRONZE_OUTPUT_DIR=bronze
