{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BehindTheMusicTree/the-music-tree-pipelines/gold/songs.schema.json",
  "title": "Reconciled songs export",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "musicbrainz_recording_id": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      },
      "title": { "type": "string", "minLength": 1 },
      "artist": { "type": "string", "minLength": 1 },
      "youtube_video_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$" },
      "youtube_unplayable_reason": {
        "enum": [null, "not_found", "not_embeddable", "private", "not_processed", "region_whitelisted"]
      },
      "genre_name": { "type": "string", "minLength": 1 }
    },
    "required": ["musicbrainz_recording_id", "title", "artist", "youtube_video_id", "youtube_unplayable_reason", "genre_name"],
    "additionalProperties": false
  }
}
