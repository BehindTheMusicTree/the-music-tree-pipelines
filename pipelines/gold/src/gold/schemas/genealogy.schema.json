{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["columns", "bands", "successions", "traditions", "traditionLinks"],
  "properties": {
    "columns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "position", "lanes"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "position": {"type": "integer", "minimum": 0},
          "lanes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["entityId", "label", "startYear", "endYear"],
              "properties": {
                "entityId": {"type": "string", "minLength": 1},
                "label": {"type": "string", "minLength": 1},
                "startYear": {"type": ["integer", "null"]},
                "endYear": {"type": "integer"}
              }
            }
          }
        }
      }
    },
    "bands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entityId", "label", "fragment", "startPosition", "endPosition", "startYear", "endYear"],
        "properties": {
          "entityId": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "fragment": {"type": "integer", "minimum": 0},
          "startPosition": {"type": "integer", "minimum": 0},
          "endPosition": {"type": "integer", "minimum": 0},
          "startYear": {"type": ["integer", "null"]},
          "endYear": {"type": ["integer", "null"]}
        }
      }
    },
    "successions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["predecessorId", "successorId"],
        "properties": {
          "predecessorId": {"type": "string", "minLength": 1},
          "successorId": {"type": "string", "minLength": 1}
        }
      }
    },
    "traditions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["wikidataId", "label", "start", "end", "anchorId", "inCanonicalTree"],
        "properties": {
          "wikidataId": {"type": "string", "pattern": "^Q[0-9]+$"},
          "label": {"type": "string", "minLength": 1},
          "start": {"type": ["integer", "null"]},
          "end": {"type": ["integer", "null"]},
          "anchorId": {"type": ["string", "null"]},
          "inCanonicalTree": {"type": "boolean"}
        }
      }
    },
    "traditionLinks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "targetId", "kind"],
        "properties": {
          "sourceId": {"type": "string", "pattern": "^Q[0-9]+$"},
          "targetId": {"type": "string", "pattern": "^Q[0-9]+$"},
          "kind": {"enum": ["lineage", "association"]}
        }
      }
    }
  }
}
