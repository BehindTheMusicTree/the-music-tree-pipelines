{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BehindTheMusicTree/the-music-tree-pipelines/gold/genre_tree.schema.json",
  "title": "Genre tree export",
  "type": "object",
  "properties": {
    "tree": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    }
  },
  "required": ["tree"],
  "additionalProperties": false,
  "$defs": {
    "node": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "side": { "type": "string", "enum": ["pop"] },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/node" }
        }
      },
      "required": ["id", "name", "children"],
      "additionalProperties": false
    }
  }
}
