{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BehindTheMusicTree/the-music-tree-pipelines/gold/genre_tree.schema.json",
  "title": "Genre tree export",
  "type": "object",
  "properties": {
    "treeName": { "enum": ["canonical", "regional"] },
    "curationExportedOn": { "type": "string", "format": "date-time", "minLength": 1 },
    "tree": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    }
  },
  "required": ["treeName", "curationExportedOn", "tree"],
  "additionalProperties": false,
  "$defs": {
    "node": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "side": { "type": "string", "enum": ["pop"] },
        "isUnacceptedRoot": { "type": "boolean", "const": true },
        "isUmbrella": { "type": "boolean", "const": true },
        "scene": { "type": "string", "enum": ["commercial", "underground"] },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/node" }
        },
        "primaryParents": { "$ref": "#/$defs/parentRefs" },
        "secondaryParents": { "$ref": "#/$defs/parentRefs" },
        "essentialSongs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "summary": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "summarySourceUrl": { "type": "string", "minLength": 1 }
      },
      "required": ["id", "name", "children"],
      "if": { "required": ["isUmbrella"] },
      "then": { "properties": { "children": { "minItems": 1 } } },
      "additionalProperties": false
    },
    "parentRefs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
