# Copy to .env (git-ignored). Auto-loaded by gold via common.env.load_pipeline_env() — no manual
# export needed.

# Silver-layer directories from the two upstream pipelines this layer reconciles (git-ignored,
# produced by `uv run --package musicbrainz python -m musicbrainz.silver` and
# `uv run --package wikidata python -m wikidata.silver`). Relative here as portable placeholders —
# in your own .env, prefer absolute paths so the location stays deterministic regardless of the
# working directory a command is run from.
MUSICBRAINZ_SILVER_DIR=../musicbrainz/silver
WIKIDATA_SILVER_DIR=../wikidata/silver

# Bronze curation CSVs (manual_*.csv) written by `uv run --package curation python -m curation.ingest`
# from grow-the-music-tree-api's curation export. Same portability note as above.
CURATION_BRONZE_DIR=../curation/bronze

# Output directory for gold-layer exports (git-ignored). Same portability note as above.
GOLD_OUTPUT_DIR=output
