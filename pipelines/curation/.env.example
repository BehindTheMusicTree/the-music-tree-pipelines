# Copy to .env (git-ignored). Auto-loaded by curation.ingest via common.env.load_pipeline_env() —
# no manual export needed.

# grow-the-music-tree-api base URL, including the version segment and trailing slash. The curation
# export is fetched from `${GROW_API_BASE_URL}curation/export/`.
GROW_API_BASE_URL=http://localhost:8000/v0/
GROW_API_KEY=

# Output directory for the bronze-layer curation CSVs (git-ignored). Relative here as a portable
# placeholder — in your own .env, prefer an absolute path. wikidata's and gold's
# CURATION_BRONZE_DIR must point at this same directory.
BRONZE_OUTPUT_DIR=bronze
