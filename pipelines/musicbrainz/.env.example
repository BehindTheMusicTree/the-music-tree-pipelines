# Copy to .env (git-ignored). Auto-loaded by musicbrainz.bronze_musicbrainz via
# common.env.load_pipeline_env() and by scripts/setup-duckdb-views.sh by sourcing this file directly — no manual export needed.
# Required by musicbrainz.db.connect(); values below match the local
# sample DB started by scripts/setup-sample-db.sh.
MB_HOST=127.0.0.1
MB_PORT=5432
MB_DB=musicbrainz_db
MB_USER=musicbrainz
PGPASSWORD=musicbrainz

# Output directory for bronze-layer Parquet files (git-ignored). Relative here as a portable
# placeholder — in your own .env, prefer an absolute path so the location stays deterministic
# regardless of the working directory a command is run from.
BRONZE_OUTPUT_DIR=bronze

# Output directory for silver-layer Parquet files (git-ignored). Same portability note as above.
SILVER_OUTPUT_DIR=silver

# Bronze curation CSVs (manual_*.csv) written by `uv run --package curation python -m curation.ingest`
# from grow-the-music-tree-api's curation export; Silver's songs step reads manual_genre_precedence.csv.
# Same portability note as above.
CURATION_BRONZE_DIR=../curation/bronze

# YouTube Data API v3 key, used by Silver's youtube_video_status step to check each candidate video's
# playability (videos.list, 1 quota unit per 50 ids). Required.
YOUTUBE_API_KEY=
