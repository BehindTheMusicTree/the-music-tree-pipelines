# Copy to .env (git-ignored). Auto-loaded by geohistory.ingest via common.env.load_pipeline_env() —
# no manual export needed.

# glottolog-cldf release tag to download (https://github.com/glottolog/glottolog-cldf/tags). Pinned so
# a run is reproducible; bumping it is an explicit decision.
GLOTTOLOG_CLDF_VERSION=v5.3

# Output directory for the bronze-layer Parquet files (git-ignored). Relative here as a portable
# placeholder — in your own .env, prefer an absolute path.
BRONZE_OUTPUT_DIR=bronze

# Wikidata Bronze directory (cultural entities and their claims), read by the Silver layer.
WIKIDATA_BRONZE_DIR=../wikidata/bronze

# Output directory for the silver-layer Parquet files (git-ignored).
SILVER_OUTPUT_DIR=silver
